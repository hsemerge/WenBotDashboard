# Local Netlify folder
.netlify
node_modules/
.env
.claude/
# Build output (generated by `npm run build` → published by Netlify)
dist/
MegWebsite/

# Raw game asset drops (~1GB of zips). Extracted assets that the site actually
# serves belong in /img/ or /games/ and are committed individually; the source
# archives are not — they would bloat every Netlify deploy.
Games/

# Firebase emulator / debug logs
firestore-debug.log
*-debug.log

# Casino session tokens dropped here for setup — never commit one.
token.txt
*.token
